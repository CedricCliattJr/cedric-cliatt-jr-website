---
import type { ContactLink } from '../types';

interface Props {
  icon: ContactLink['icon'];
}

const { icon } = Astro.props;
---

<svg class="contact-icon" viewBox="0 0 16 16" aria-hidden="true" data-icon={icon}>
  {icon === 'email' && (
    <>
      <rect x="1.5" y="3" width="13" height="10" rx="1.6" />
      <path d="m2 4.5 6 4.2 6-4.2" />
    </>
  )}
  {icon === 'github' && (
    <path
      class="contact-icon__solid"
      d="M8 0a8 8 0 0 0-2.53 15.59c.4.07.55-.17.55-.38l-.01-1.34c-2.23.48-2.7-1.07-2.7-1.07-.36-.93-.89-1.18-.89-1.18-.73-.5.06-.49.06-.49.8.06 1.23.83 1.23.83.72 1.23 1.88.87 2.34.67.07-.52.28-.87.51-1.07-1.78-.2-3.64-.89-3.64-3.95 0-.87.31-1.59.82-2.15-.08-.2-.36-1.01.08-2.12 0 0 .67-.21 2.2.82a7.6 7.6 0 0 1 4 0c1.53-1.03 2.2-.82 2.2-.82.44 1.11.16 1.92.08 2.12.51.56.82 1.28.82 2.15 0 3.07-1.87 3.75-3.65 3.95.29.25.54.73.54 1.48l-.01 2.19c0 .21.15.46.55.38A8 8 0 0 0 8 0Z"
    />
  )}
  {icon === 'linkedin' && (
    <>
      <rect x="1.5" y="1.5" width="13" height="13" rx="2" />
      <path d="M5 6.6v5M5 4.3v.1M8 11.6v-5M8 8.2c0-1 .7-1.6 1.6-1.6s1.5.6 1.5 1.7v3.3" />
    </>
  )}
  {icon === 'link' && (
    <>
      <path d="M6.6 9.4a2.6 2.6 0 0 0 3.7 0l2.1-2.1a2.6 2.6 0 0 0-3.7-3.7l-.7.7" />
      <path d="M9.4 6.6a2.6 2.6 0 0 0-3.7 0L3.6 8.7a2.6 2.6 0 0 0 3.7 3.7l.7-.7" />
    </>
  )}
</svg>

<style>
  .contact-icon {
    width: 1.05rem;
    height: 1.05rem;
    fill: none;
    stroke: currentColor;
    stroke-width: 1.35;
    stroke-linecap: round;
    stroke-linejoin: round;
    flex-shrink: 0;
  }

  .contact-icon__solid {
    fill: currentColor;
    stroke: none;
  }
</style>
