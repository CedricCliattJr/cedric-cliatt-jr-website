---
import Section from '../components/Section.astro';
import { about } from '../data/about';
---

<Section id="about" eyebrow="01 — About" title={about.lead} alt>
  <div class="about">
    <div class="about__prose" data-reveal>
      {about.paragraphs.map((paragraph) => <p>{paragraph}</p>)}
    </div>

    <aside class="about__facts" data-reveal data-reveal-delay="80">
      <h3 class="about__facts-title">At a glance</h3>
      <dl>
        {
          about.facts.map((fact) => (
            <div class="about__fact">
              <dt>{fact.label}</dt>
              <dd>{fact.value}</dd>
            </div>
          ))
        }
      </dl>
    </aside>
  </div>
</Section>

<style>
  .about {
    display: grid;
    gap: clamp(2rem, 4vw, 3rem);
    align-items: start;
  }

  @media (min-width: 900px) {
    .about {
      grid-template-columns: minmax(0, 1.55fr) minmax(0, 1fr);
    }
  }

  .about__prose {
    display: grid;
    gap: 1.05rem;
    max-width: var(--measure);
  }

  .about__prose p {
    color: var(--text-muted);
    font-size: 1rem;
  }

  .about__prose p:first-child {
    color: var(--text);
    font-size: 1.05rem;
  }

  .about__facts {
    background: var(--surface);
    border: 1px solid var(--border);
    border-radius: var(--radius-lg);
    padding: 1.35rem 1.4rem;
    position: sticky;
    top: 5.5rem;
  }

  .about__facts-title {
    font-family: var(--font-mono);
    font-size: 0.68rem;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    color: var(--text-faint);
    font-weight: 500;
    margin-bottom: 1rem;
  }

  .about__facts dl {
    display: grid;
    gap: 1rem;
    margin: 0;
  }

  .about__fact dt {
    font-size: 0.72rem;
    font-family: var(--font-mono);
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: var(--text-faint);
    margin-bottom: 0.2rem;
  }

  .about__fact dd {
    margin: 0;
    font-size: 0.9rem;
    color: var(--text);
    line-height: 1.5;
  }

  @media (max-width: 899px) {
    .about__facts {
      position: static;
    }
  }
</style>
