---
import Section from '../components/Section.astro';
import ContactIcon from '../components/ContactIcon.astro';
import { contactLinks } from '../data/site';
---

<Section
  id="contact"
  eyebrow="07 — Contact"
  title="Get in touch"
  lead="Happy to talk about cloud and networking work, a project, or a role. The quickest way to reach me is below."
  alt
>
  <ul class="contact">
    {
      contactLinks.map((link, index) => {
        const isPlaceholder = link.href === null;
        const Tag = isPlaceholder ? 'div' : 'a';

        return (
          <li data-reveal data-reveal-delay={index * 50}>
            <Tag
              class:list={['contact__row', isPlaceholder && 'contact__row--placeholder']}
              href={link.href ?? undefined}
              rel={isPlaceholder ? undefined : 'noopener'}
            >
              <span class="contact__icon">
                <ContactIcon icon={link.icon} />
              </span>
              <span class="contact__text">
                <span class="contact__label">{link.label}</span>
                <span class="contact__value">{link.value}</span>
              </span>
              {!isPlaceholder && (
                <svg class="contact__arrow" viewBox="0 0 16 16" aria-hidden="true">
                  <path d="M4.5 11.5 11.5 4.5M6 4.5h5.5V10" />
                </svg>
              )}
            </Tag>
          </li>
        );
      })
    }
  </ul>
</Section>

<style>
  .contact {
    display: grid;
    gap: 0.75rem;
    grid-template-columns: repeat(auto-fit, minmax(min(100%, 380px), 1fr));
    margin: 0;
  }

  .contact__row {
    display: flex;
    align-items: center;
    gap: 0.9rem;
    height: 100%;
    padding: 1rem 1.15rem;
    background: var(--surface);
    border: 1px solid var(--border);
    border-radius: var(--radius-lg);
    text-decoration: none;
    color: var(--text);
    transition: border-color 0.18s ease, transform 0.18s ease,
      box-shadow 0.18s ease;
  }

  a.contact__row:hover {
    border-color: var(--accent-line);
    transform: translateY(-2px);
    box-shadow: var(--shadow);
  }

  .contact__row--placeholder {
    border-style: dashed;
    color: var(--text-faint);
  }

  .contact__icon {
    display: grid;
    place-items: center;
    width: 2.15rem;
    height: 2.15rem;
    border-radius: 8px;
    background: var(--surface-2);
    border: 1px solid var(--border);
    color: var(--accent);
    flex-shrink: 0;
  }

  .contact__row--placeholder .contact__icon {
    color: var(--text-faint);
  }

  .contact__text {
    display: grid;
    gap: 0.1rem;
    min-width: 0;
  }

  .contact__label {
    font-family: var(--font-mono);
    font-size: 0.66rem;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    color: var(--text-faint);
  }

  .contact__value {
    font-size: 0.9rem;
    overflow-wrap: anywhere;
  }

  .contact__arrow {
    width: 0.95rem;
    height: 0.95rem;
    margin-left: auto;
    fill: none;
    stroke: currentColor;
    stroke-width: 1.5;
    stroke-linecap: round;
    stroke-linejoin: round;
    color: var(--text-faint);
    flex-shrink: 0;
  }

  a.contact__row:hover .contact__arrow {
    color: var(--accent);
  }
</style>
