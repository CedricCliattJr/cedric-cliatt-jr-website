---
import Section from '../components/Section.astro';
import { skillCategories } from '../data/skills';
---

<Section
  id="skills"
  eyebrow="02 — Skills"
  title="Technologies I work with"
  lead="Grouped by area rather than dumped in one list. These are things I've worked with — the depth varies, and I'd rather say that plainly than imply mastery across the board."
>
  <div class="skills">
    {
      skillCategories.map((category, index) => (
        <article class="skills__group" data-reveal data-reveal-delay={index * 50}>
          <header class="skills__head">
            <h3>{category.name}</h3>
            <p>{category.blurb}</p>
          </header>
          <ul class="skills__list">
            {category.skills.map((skill) => (
              <li class="skills__item">{skill}</li>
            ))}
          </ul>
        </article>
      ))
    }
  </div>
</Section>

<style>
  .skills {
    display: grid;
    gap: 1rem;
    grid-template-columns: repeat(auto-fill, minmax(min(100%, 285px), 1fr));
  }

  .skills__group {
    background: var(--surface);
    border: 1px solid var(--border);
    border-radius: var(--radius-lg);
    padding: 1.25rem 1.3rem 1.35rem;
    display: flex;
    flex-direction: column;
    gap: 1rem;
    transition: border-color 0.2s ease;
  }

  .skills__group:hover {
    border-color: var(--border-strong);
  }

  .skills__head h3 {
    margin-bottom: 0.3rem;
  }

  .skills__head p {
    font-size: 0.85rem;
    color: var(--text-muted);
    margin: 0;
  }

  .skills__list {
    display: flex;
    flex-wrap: wrap;
    gap: 0.4rem;
    margin: 0;
    margin-top: auto;
  }

  .skills__item {
    font-family: var(--font-mono);
    font-size: 0.735rem;
    color: var(--text);
    background: var(--surface-2);
    border: 1px solid var(--border);
    border-radius: 6px;
    padding: 0.22rem 0.5rem;
    line-height: 1.5;
  }
</style>
