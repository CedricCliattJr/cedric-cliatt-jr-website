---
import BaseLayout from '../layouts/BaseLayout.astro';
import { site } from '../data/site';

const base = import.meta.env.BASE_URL;
---

<BaseLayout title={`Page not found — ${site.name}`} description="This page doesn't exist.">
  <section class="notfound">
    <div class="container notfound__inner">
      <p class="notfound__code">404</p>
      <h1>That page isn't here</h1>
      <p class="lead">The link may be out of date, or the page may have moved.</p>
      <a class="btn btn--primary" href={base}>Back to the homepage</a>
    </div>
  </section>
</BaseLayout>

<style>
  .notfound {
    display: grid;
    place-items: center;
    padding-block: clamp(4rem, 14vh, 9rem);
    flex: 1;
  }

  .notfound__inner {
    display: grid;
    gap: 1rem;
    justify-items: start;
    max-width: 46ch;
  }

  .notfound__code {
    font-family: var(--font-mono);
    font-size: 0.75rem;
    letter-spacing: 0.2em;
    color: var(--accent);
    margin: 0;
  }

  .notfound .btn {
    margin-top: 0.75rem;
  }
</style>
