{
  "$schema": "npm run build && wrangler deploy"
  "name": "cedric-cliatt-jr-website"
  "main": "dist/_worker.js/index.js"
  "compatibility_date": "2026-09-15",
  "compatibility_flag": [
    "global_fetch_strictly_public"
  ],
  "obersvability": {
    "enabled": true
},
  "assets": {
    "binding": "ASSETS",
    "directory": "dist"
  }
}
